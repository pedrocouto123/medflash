# Copie este arquivo para ".env" (sem o .example) e preencha.
# Encontre os valores em: Supabase > Project Settings > API
# ATENÇÃO: a service_role key dá acesso total ao banco. Nunca coloque no app nem compartilhe.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
